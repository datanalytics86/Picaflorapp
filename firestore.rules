rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function blockedEitherWay(otherUid) {
      return exists(/databases/$(database)/documents/blocks/$(request.auth.uid)/blocked/$(otherUid))
        || exists(/databases/$(database)/documents/blocks/$(otherUid)/blocked/$(request.auth.uid));
    }

    function userKeys() {
      return [
        'email', 'phone', 'birthDate', 'fcmTokens', 'settings',
        'consents', 'lastActiveAt', 'createdAt', 'updatedAt'
      ];
    }

    function userFieldsValid(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('birthDate' in data) || data.birthDate is string || data.birthDate is timestamp)
        && (!('birthDate' in data) || !(data.birthDate is string) || data.birthDate.size() <= 40)
        && (!('fcmTokens' in data) || data.fcmTokens is list || data.fcmTokens is map)
        && (!('settings' in data) || data.settings is map)
        && (!('consents' in data) || data.consents is map)
        && (!('lastActiveAt' in data) || data.lastActiveAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function interestOk(value) {
      return value is string && value.size() > 0 && value.size() <= 24;
    }

    function interestsOk(ints) {
      return ints is list
        && ints.size() <= 8
        && (ints.size() < 1 || interestOk(ints[0]))
        && (ints.size() < 2 || interestOk(ints[1]))
        && (ints.size() < 3 || interestOk(ints[2]))
        && (ints.size() < 4 || interestOk(ints[3]))
        && (ints.size() < 5 || interestOk(ints[4]))
        && (ints.size() < 6 || interestOk(ints[5]))
        && (ints.size() < 7 || interestOk(ints[6]))
        && (ints.size() < 8 || interestOk(ints[7]));
    }

    function profileFieldsValid(data) {
      return (!('displayName' in data) || (
          data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 40
        ))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 160))
        && (!('isVisible' in data) || data.isVisible is bool)
        && (!('photoUrl' in data) || data.photoUrl == null || (
          data.photoUrl is string && data.photoUrl.size() <= 500
        ))
        && (!('interests' in data) || interestsOk(data.interests));
    }

    function profileClientKeys() {
      return ['displayName', 'bio', 'interests', 'photoUrl', 'isVisible'];
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatParticipant(chatId) {
      return isSignedIn() && request.auth.uid in chatDoc(chatId).participantIds;
    }

    // Missing status is legacy active. Anything else, including blocked, cannot post.
    function chatAcceptsMessages(chatId) {
      let data = chatDoc(chatId);
      return !('status' in data) || data.status == 'active';
    }

    function mapDiffOnlySelf(field) {
      let before = resource.data.get(field, {});
      let after = request.resource.data.get(field, {});
      return after is map
        && before is map
        && request.auth.uid in after
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
    }

    function chatMetaUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['unreadCount', 'lastRead', 'muted'])
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && (!('unreadCount' in changed) || (
          mapDiffOnlySelf('unreadCount')
          && (
            request.resource.data.unreadCount[request.auth.uid] is int
            || request.resource.data.unreadCount[request.auth.uid] is float
          )
          && request.resource.data.unreadCount[request.auth.uid] >= 0
        ))
        && (!('lastRead' in changed) || (
          mapDiffOnlySelf('lastRead')
          && request.resource.data.lastRead[request.auth.uid] is timestamp
        ))
        && (!('muted' in changed) || (
          mapDiffOnlySelf('muted')
          && request.resource.data.muted[request.auth.uid] is bool
        ));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userKeys())
        && userFieldsValid(request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys())
        && userFieldsValid(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || !blockedEitherWay(userId));
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(profileClientKeys())
        && request.resource.data.keys().hasAll(['displayName', 'bio', 'interests', 'isVisible'])
        && profileFieldsValid(request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileClientKeys())
        && profileFieldsValid(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Geohash cells. Clients never read or write; callables use the Admin SDK.
    match /locations/{userId} {
      allow read, write: if false;
    }

    match /waves/{waveId} {
      allow read: if isSignedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if false;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && chatMetaUpdateOk();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && chatAcceptsMessages(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in chatDoc(chatId).participantIds
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /blocks/{userId}/blocked/{otherId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && otherId != userId;
      allow delete: if isOwner(userId) && otherId != userId;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'sexual', 'minor', 'fake', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow read, update, delete: if false;
    }

    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
